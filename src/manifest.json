{
  "manifest_version": 3,
  "name": "PageSage",
  "version": "1.3",
  "description": "Strict, reliable page summarizer utilizing Gemini.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pagesage-summarizer@example.com",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "PageSage"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      }
    }
  }
}